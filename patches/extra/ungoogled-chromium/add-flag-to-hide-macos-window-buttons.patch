+// Cover both the opt-in switch and unchanged default behavior.
+class HideMacosWindowButtonsBrowserTest
+    : public InProcessBrowserTest,
+      public testing::WithParamInterface<bool> {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    if (GetParam()) {
+      command_line->AppendSwitch("hide-macos-window-buttons");
+    }
+  }
+
+  void CheckButtonsAndLayout(BrowserWindowInterface* browser) {
+    NSWindow* window =
+        browser->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+    ASSERT_TRUE(window);
+    // Hiding must not disable window actions or change its native capabilities.
+    EXPECT_TRUE(window.styleMask & NSWindowStyleMaskClosable);
+    EXPECT_TRUE(window.styleMask & NSWindowStyleMaskMiniaturizable);
+    EXPECT_TRUE(window.styleMask & NSWindowStyleMaskResizable);
+    for (NSWindowButton type :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* button = [window standardWindowButton:type];
+      ASSERT_TRUE(button);
+      EXPECT_EQ(button.hidden, GetParam());
+    }
+
+    BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+    auto* frame_view = static_cast<BrowserFrameView*>(
+        browser_view->GetWidget()->non_client_view()->frame_view());
+    const auto params = frame_view->GetBrowserLayoutParams();
+    if (GetParam()) {
+      EXPECT_TRUE(params.leading_exclusion.IsEmpty());
+      EXPECT_TRUE(params.trailing_exclusion.IsEmpty());
+    } else {
+      // Caption buttons can occupy either side in RTL configurations.
+      EXPECT_GT(params.leading_exclusion.content.width() +
+                    params.trailing_exclusion.content.width(),
+                0);
+    }
+  }
+};
+
+IN_PROC_BROWSER_TEST_P(HideMacosWindowButtonsBrowserTest,
+                       ButtonsAndCaptionExclusion) {
+  ASSERT_NO_FATAL_FAILURE(CheckButtonsAndLayout(browser()));
+  ASSERT_NO_FATAL_FAILURE(CheckButtonsAndLayout(CreateBrowser(GetProfile())));
+  ASSERT_NO_FATAL_FAILURE(CheckButtonsAndLayout(CreateIncognitoBrowser()));
+}
+
+IN_PROC_BROWSER_TEST_P(HideMacosWindowButtonsBrowserTest,
+                       ButtonsAndCaptionExclusionAfterResize) {
+  NSWindow* window =
+      browser()->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  NSRect frame = window.frame;
+  frame.size.width += 100;
+  [window setFrame:frame display:YES];
+  ASSERT_NO_FATAL_FAILURE(CheckButtonsAndLayout(browser()));
+}
+
+INSTANTIATE_TEST_SUITE_P(All,
+                         HideMacosWindowButtonsBrowserTest,
+                         testing::Bool());
+
