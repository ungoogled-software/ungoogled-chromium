+
+// The creation parameter also works for remote app windows: the display process
+// need not inherit the browser's command line.
+TEST(BrowserNativeWidgetWindowTest, HideWindowButtons) {
+  for (auto window_class : {remote_cocoa::mojom::WindowClass::kBrowser,
+                            remote_cocoa::mojom::WindowClass::kDefault}) {
+    auto params = remote_cocoa::mojom::CreateWindowParams::New();
+    params->window_class = window_class;
+    params->style_mask = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                         NSWindowStyleMaskMiniaturizable |
+                         NSWindowStyleMaskResizable;
+    params->hide_window_buttons = true;
+    NativeWidgetMacNSWindow* window =
+        remote_cocoa::NativeWidgetNSWindowBridge::CreateNSWindow(params.get());
+    ASSERT_TRUE(window.hideWindowButtons);
+    EXPECT_EQ(window.styleMask, params->style_mask);
+
+    const NSWindowButton kButtons[] = {
+        NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+    for (NSWindowButton type : kButtons) {
+      NSButton* button = [window standardWindowButton:type];
+      ASSERT_TRUE(button);
+      EXPECT_TRUE(button.hidden);
+
+      // Simulate AppKit revealing an existing control during frame layout.
+      button.hidden = NO;
+      NSView* frame_view = window.contentView.superview;
+      [frame_view setNeedsLayout:YES];
+      [frame_view layoutSubtreeIfNeeded];
+      EXPECT_TRUE(button.hidden);
+    }
+
+    // Changing the style mask may replace the native frame and its buttons.
+    window.styleMask |= NSWindowStyleMaskFullSizeContentView;
+    for (NSWindowButton type : kButtons) {
+      EXPECT_TRUE([window standardWindowButton:type].hidden);
+    }
+
+    window.hideWindowButtons = NO;
+    for (NSWindowButton type : kButtons) {
+      EXPECT_FALSE([window standardWindowButton:type].hidden);
+    }
+    [window close];
+  }
+}
+
+TEST(BrowserNativeWidgetWindowTest, WindowButtonsVisibleByDefault) {
+  auto params = remote_cocoa::mojom::CreateWindowParams::New();
+  params->window_class = remote_cocoa::mojom::WindowClass::kBrowser;
+  params->style_mask = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                       NSWindowStyleMaskMiniaturizable |
+                       NSWindowStyleMaskResizable;
+  NativeWidgetMacNSWindow* window =
+      remote_cocoa::NativeWidgetNSWindowBridge::CreateNSWindow(params.get());
+  EXPECT_FALSE(window.hideWindowButtons);
+  for (NSWindowButton type :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* button = [window standardWindowButton:type];
+    ASSERT_TRUE(button);
+    EXPECT_FALSE(button.hidden);
+  }
+  [window close];
+}
+
+TEST(BrowserNativeWidgetWindowTest, HideOverridesAlwaysShowTrafficLights) {
+  auto params = remote_cocoa::mojom::CreateWindowParams::New();
+  params->window_class = remote_cocoa::mojom::WindowClass::kBrowser;
+  params->style_mask = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                       NSWindowStyleMaskMiniaturizable |
+                       NSWindowStyleMaskResizable;
+  params->hide_window_buttons = true;
+  BrowserNativeWidgetWindow* window =
+      base::apple::ObjCCastStrict<BrowserNativeWidgetWindow>(
+          remote_cocoa::NativeWidgetNSWindowBridge::CreateNSWindow(
+              params.get()));
+  NSThemeFrame* frame =
+      base::apple::ObjCCastStrict<NSThemeFrame>(window.contentView.superview);
+  NSButton* close_button = [window standardWindowButton:NSWindowCloseButton];
+  NSButton* minimize_button =
+      [window standardWindowButton:NSWindowMiniaturizeButton];
+  NSButton* zoom_button = [window standardWindowButton:NSWindowZoomButton];
+  ASSERT_TRUE(close_button);
+  ASSERT_TRUE(minimize_button);
+  ASSERT_TRUE(zoom_button);
+
+  [window setAlwaysShowTrafficLights:YES];
+  [frame setButtonRevealAmount:0.0];
+  [frame setButtonRevealAmount:1.0];
+  // Check the retained buttons, not the getter that also enforces hiding.
+  EXPECT_TRUE(close_button.hidden);
+  EXPECT_TRUE(minimize_button.hidden);
+  EXPECT_TRUE(zoom_button.hidden);
+  [window close];
 }
 
