--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -4196,6 +4196,13 @@ source_set("browser") {
   if (is_chrome_for_testing) {
     deps += [ "//chrome/browser/chrome_for_testing" ]
   }
+
+  # This is already handled above in the CfT config and isn't needed on
+  # Apple's platforms (which use a platform-specific hyphenation engine).
+  if (!is_chrome_for_testing && !is_apple) {
+    deps += [ "//third_party/hyphenation-patterns:bundle_hyphen_data" ]
+  }
+
   if (enable_rlz) {
     deps += [ "//chrome/browser/rlz" ]
   }
